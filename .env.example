AUTO_WRITER_ENV=prod
AUTO_WRITER_SECRET_KEY_FILE=/data/secrets/secret_key
AUTO_WRITER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/autowriter
AUTO_WRITER_REDIS_URL=redis://redis:6379/0
AUTO_WRITER_DEEPSEEK_API_KEY_FILE=/data/secrets/deepseek_api_key
AUTO_WRITER_DEEPSEEK_BASE_URL=https://api.deepseek.com
AUTO_WRITER_DEEPSEEK_MODEL=deepseek-chat
AUTO_WRITER_ARTIFACTS_DIR=/data/artifacts
AUTO_WRITER_DB_PORT=5413
AUTO_WRITER_API_HOST_PORT=8413
AUTO_WRITER_FRONTEND_PORT=3413
